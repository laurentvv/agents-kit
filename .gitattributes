# agents-kit artifacts: byte-frozen sources and installs (LF), the DuckDB ledger (binary)
skills/** text eol=lf
scripts/** text eol=lf
.agents/skills/** text eol=lf
.agent/*.duckdb* binary

# Binary assets inside vendored skills: never line-convert them (lesson 2026-10-19,
# first vendored skill shipping jpg/gif - a forced eol=lf would corrupt the blobs
# and break the byte-strict fingerprints on a fresh clone)
*.jpg -text
*.jpeg -text
*.png -text
*.gif -text
*.webp -text
*.mp4 -text
*.mp3 -text
*.wav -text
*.m4a -text
*.woff -text
*.woff2 -text
*.ttf -text
*.otf -text

# Windows batch launchers ship CRLF upstream (impeccable, 2026-10-31): converting
# them to LF would both break cmd.exe label parsing and drift the byte-strict
# fingerprints on every fresh clone (same mechanism as lesson 2026-10-18)
*.cmd -text
*.bat -text

# Templates are canon material: byte-stable across checkouts (lesson 2026-10-18)
template/** text eol=lf
skills.json text eol=lf

# Vendored upstream notices: byte-stable verbatim copies (same discipline as
# skills.json - a CRLF smudge on checkout would break the verbatim claim)
docs/upstream-notices/** text eol=lf
